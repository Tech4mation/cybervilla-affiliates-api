# ---------------------------------------------------------------------------
# cybervilla-affiliates-api — copy to .env and fill in.
# Nothing here has a safe default in production; the service refuses to start
# without DATABASE_URL, and the catalogue stays empty without the Odoo block.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# PostgreSQL. The +psycopg suffix selects the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://affiliates:affiliates@localhost:5432/affiliates

# The CyberVilla store (Odoo) -----------------------------------------------
# api_key is generated in Odoo under Settings > Technical > API Keys.
ODOO_URL=https://www.cybervilla.io
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=

# How old the stored catalogue may get before /products reports it as stale.
CATALOGUE_TTL_MINUTES=60

# Web -----------------------------------------------------------------------
# Comma-separated origins allowed to call this API from a browser.
# * is fine locally; name the real dashboard origin in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Shared secret for the internal endpoints (catalogue refresh, and creating
# affiliates/links). Leave blank and those endpoints refuse every call, which
# is the right default.
INTERNAL_API_KEY=

# The affiliate store integration -------------------------------------------
# Shared with the cybervilla_affiliate Odoo module. It must equal that module's
# `cybervilla_affiliate.webhook_secret`, because Odoo signs every paid/cancelled
# notification with it and we refuse any that does not match. Leave blank and
# the /odoo/webhook endpoint refuses everything.
ODOO_WEBHOOK_SECRET=

# The most an affiliate may add to a price. Matches the module's ceiling.
MAX_MARKUP_PERCENT=10

# Authentication & Admin ---------------------------------------------------
# Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRY_HOURS=72
ADMIN_EMAIL=admin@cybervilla.io
# Required. Use a generated value, not a memorable one.
ADMIN_PASSWORD=
ADMIN_NAME=CyberVilla Admin

# Optional ------------------------------------------------------------------
LOG_LEVEL=INFO

